                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ledger?txnId={{txnId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ledger"
              ],
              "query": [
                {
                  "key": "txnId",
                  "value": "{{txnId}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
